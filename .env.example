# Copy to .env and fill in. Never commit .env.

# Use letters and digits only, or percent-encode special characters: the
# password is placed inside a postgres:// URL.
POSTGRES_PASSWORD=
POSTGRES_USER=jackpot
POSTGRES_DB=jackpot
POSTGRES_PORT=5432

# Only used by the `app` profile.
JACKPOT_GAME=jackpot
JACKPOT_ORIGINS=jackpot.start.ng
JACKPOT_PORT=8080
